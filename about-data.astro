  }
  .page__title{
    font-family:'Fraunces', serif; font-weight:600; font-size:clamp(32px, 5vw, 44px);
    margin:0 0 20px; color:var(--ink-text);
  }
  .page__intro{
    font-size:16px; line-height:1.65; color:var(--ink-muted); margin:0 0 40px;
    padding-bottom:32px; border-bottom:1px solid var(--paper-line);
  }
  .block{ margin-bottom:36px; }
  .block h2{
    font-family:'Fraunces', serif; font-size:19px; font-weight:600;
    margin:0 0 12px; color:var(--ink-text);
  }
  .block p{ font-size:15px; line-height:1.7; color:var(--ink-text); margin:0; }
  .block ul{ margin:0; padding-left:20px; }
