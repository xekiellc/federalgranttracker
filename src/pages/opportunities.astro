---
import Base from '../layouts/Base.astro';
import { env } from 'cloudflare:workers';

const query = Astro.url.searchParams.get('q')?.trim() ?? '';

let results: {
  slug: string;
  title: string;
  status: string;
  posted_date: string | null;
  agency_name: string | null;
}[] = [];
let totalOpen = 0;

try {
  const db = (env as any)?.DB;
  if (db) {
    const totalResult = await db
      .prepare(`SELECT COUNT(*) as count FROM opportunities WHERE status IN ('forecasted', 'posted')`)
      .first();
    totalOpen = (totalResult?.count as number) ?? 0;

    if (query) {
      const result = await db
        .prepare(`
          SELECT o.slug, o.title, o.status, o.posted_date, a.name as agency_name
          FROM opportunities o
          LEFT JOIN agencies a ON o.agency_id = a.id
          WHERE o.title LIKE ? OR a.name LIKE ?
          ORDER BY o.posted_date DESC
          LIMIT 50
        `)
        .bind(`%${query}%`, `%${query}%`)
        .all();
      results = (result?.results as any[]) ?? [];
    } else {
      const result = await db
        .prepare(`
          SELECT o.slug, o.title, o.status, o.posted_date, a.name as agency_name
          FROM opportunities o
          LEFT JOIN agencies a ON o.agency_id = a.id
          WHERE o.status IN ('forecasted', 'posted')
          ORDER BY o.posted_date DESC
          LIMIT 50
        `)
        .all();
      results = (result?.results as any[]) ?? [];
    }
  }
} catch (err) {
  console.error('Opportunities search D1 query failed:', err);
}

function formatDate(iso: string | null): string {
  if (!iso) return '—';
  const d = new Date(iso + 'T00:00:00Z');
  if (isNaN(d.getTime())) return '—';
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}

const pageTitle = query
  ? `"${query}" — Opportunities — Federal Grant Tracker`
  : 'Opportunities — Federal Grant Tracker';
---
<Base title={pageTitle}>

<div class="wrap">
  <p class="breadcrumb"><a href="/">Home</a> / Opportunities</p>

  <form class="search-line" role="search" method="get" action="/opportunities">
    <input type="text" name="q" value={query} placeholder="Search a grant, recipient, agency, program, or place…" aria-label="Search opportunities">
    <button type="submit">Search</button>
  </form>

  <p class="sub">
    {query
      ? `${results.length} result${results.length === 1 ? '' : 's'} for "${query}"`
      : `Showing ${results.length} of ${totalOpen} open ${totalOpen === 1 ? 'opportunity' : 'opportunities'}`}
  </p>

  {results.length > 0 ? (
    <div class="list">
      {results.map((opp) => (
        <a class="row" href={`/opportunity/${opp.slug}`}>
          <span class={`flag flag--${opp.status}`}>{opp.status}</span>
          <span class="row__main">
            <span class="row__title">{opp.title}</span>
            <span class="row__agency">{opp.agency_name ?? 'Agency unknown'}</span>
          </span>
          <span class="row__date">Posted {formatDate(opp.posted_date)}</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="empty">
      {query
        ? `No tracked opportunities match "${query}". Try a different term, or an agency name.`
        : 'No open opportunities currently tracked.'}
    </p>
  )}
</div>

</Base>

<style>
  .wrap{ max-width:900px; margin:0 auto; padding:34px 28px 60px; }
  .breadcrumb{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--ink-muted); margin:0 0 20px; }
  .breadcrumb a{ text-decoration:none; color:var(--ink-muted); }
  .breadcrumb a:hover{ color:var(--verdigris-deep); }

  .search-line{
    display:flex; align-items:center; gap:12px; background:var(--paper-soft);
    border:1px solid var(--ink); padding:6px 6px 6px 20px; margin-bottom:20px; border-radius:2px;
  }
  .search-line input{
    border:none; background:transparent; flex:1; font-family:'IBM Plex Mono', monospace;
    font-size:14px; padding:12px 0; color:var(--ink-text);
  }
  .search-line input:focus{ outline:none; }
  .search-line button{
    background:var(--verdigris-deep); color:var(--paper); border:none; padding:11px 20px;
    border-radius:1px; font-weight:600; font-size:13px; cursor:pointer; font-family:inherit; white-space:nowrap;
  }
  .search-line button:hover{ background:#255241; }

  .sub{ font-size:14px; color:var(--ink-muted); margin-bottom:20px; }

  .list{ border:1px solid var(--paper-line); background:var(--paper-soft); }
  .row{
    display:grid; grid-template-columns:100px 1fr 140px; gap:16px; align-items:center;
    padding:16px 20px; border-top:1px solid var(--paper-line); text-decoration:none; color:inherit;
  }
  .row:first-child{ border-top:none; }
  .row:hover{ background:var(--paper); }
  .row__main{ display:flex; flex-direction:column; gap:3px; min-width:0; }
  .row__title{ font-size:14.5px; color:var(--ink-text); }
  .row__agency{ font-size:12px; color:var(--ink-muted); font-family:'IBM Plex Mono', monospace; }
  .row__date{ font-size:12px; color:var(--ink-muted); font-family:'IBM Plex Mono', monospace; text-align:right; }

  .flag{
    font-family:'IBM Plex Mono', monospace; font-size:10px; font-weight:600; letter-spacing:0.06em;
    text-transform:uppercase; padding:4px 8px; border-radius:2px; text-align:center; width:fit-content;
  }
  .flag--forecasted{ background:rgba(180,137,46,0.18); color:var(--gold); }
  .flag--posted{ background:rgba(79,156,130,0.18); color:var(--verdigris-deep); }
  .flag--closed{ background:rgba(91,107,112,0.18); color:var(--ink-muted); }
  .flag--archived{ background:rgba(91,107,112,0.12); color:var(--ink-muted); }

  .empty{ font-size:14px; color:var(--ink-muted); border:1px dashed var(--paper-line); padding:24px; border-radius:2px; }

  @media (max-width: 600px){
    .row{ grid-template-columns:1fr; gap:6px; }
    .row__date{ text-align:left; }
  }
</style>
