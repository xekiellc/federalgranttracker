---
import Base from '../layouts/Base.astro';
import { env } from 'cloudflare:workers';

let latestRuns: {
  source: string;
  started_at: string;
  finished_at: string | null;
  status: string;
  records_processed: number;
}[] = [];
let agencyNames: string[] = [];
let stateDataCount: number | null = null;
let matchCounts: { match_confidence: string; count: number }[] = [];

try {
  const db = (env as any)?.DB;
  if (db) {
    const result = await db
      .prepare(`
        SELECT source, started_at, finished_at, status, records_processed
        FROM sync_runs
        WHERE status = 'success'
        AND id IN (
          SELECT MAX(id) FROM sync_runs WHERE status = 'success' GROUP BY source
        )
      `)
      .all();
    latestRuns = (result?.results as any[]) ?? [];

    const agenciesResult = await db
      .prepare(`SELECT name FROM agencies ORDER BY name`)
      .all();
    agencyNames = ((agenciesResult?.results as any[]) ?? []).map((a) => a.name);

    const stateDataResult = await db
      .prepare(`SELECT COUNT(*) as count FROM awards WHERE place_of_performance_state_id IS NOT NULL`)
      .first();
    stateDataCount = (stateDataResult?.count as number) ?? 0;

    const matchResult = await db
      .prepare(`SELECT match_confidence, COUNT(*) as count FROM awards WHERE match_confidence IS NOT NULL GROUP BY match_confidence`)
      .all();
    matchCounts = (matchResult?.results as any[]) ?? [];
  }
} catch (err) {
  console.error('About-data page D1 query failed:', err);
}

function formatDateTime(iso: string | null): string {
  if (!iso) return '—';
  const d = new Date(iso.replace(' ', 'T') + 'Z');
  if (isNaN(d.getTime())) return '—';
  return d.toLocaleString('en-US', {
    month: 'short', day: 'numeric', year: 'numeric',
    hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
  });
}

const grantsGovRun = latestRuns.find((r) => r.source === 'grants_gov');
const usaspendingRun = latestRuns.find((r) => r.source === 'usaspending');
const exactMatchCount = matchCounts.find((m) => m.match_confidence === 'exact')?.count ?? 0;
const cfdaMatchCount = matchCounts.find((m) => m.match_confidence === 'cfda_inferred')?.count ?? 0;
---
<Base title="About this data — Federal Grant Tracker">

<div class="wrap">
  <p class="breadcrumb"><a href="/">Home</a> / About this data</p>
  <h1 class="title">About this data</h1>

  <p class="intro">
    Federal Grant Tracker is an independent project, not affiliated with any federal agency.
    Data is pulled directly from two official government sources on a recurring schedule, covering
    {agencyNames.length > 0 ? agencyNames.length : 'the'} tracked {agencyNames.length === 1 ? 'agency' : 'agencies'}{agencyNames.length > 0 ? `: ${agencyNames.join(', ')}.` : '.'}
  </p>

  <div class="source-card">
    <h2>Grants.gov — funding opportunities</h2>
    <p class="source-desc">Opportunity postings, forecasts, and lifecycle status (forecasted / posted / closed / archived) come directly from Grants.gov's public search API, across every agency this site tracks.</p>
    {grantsGovRun ? (
      <ul class="stat-list">
        <li><span>Last successful sync</span><span class="mono">{formatDateTime(grantsGovRun.started_at)}</span></li>
        <li><span>Records processed that run</span><span class="mono">{grantsGovRun.records_processed}</span></li>
      </ul>
    ) : (
      <p class="empty">No successful sync recorded yet.</p>
    )}
  </div>

  <div class="source-card">
    <h2>USASpending.gov — awards, recipients, and place of performance</h2>
    <p class="source-desc">Award amounts, recipients, funding totals, and (where an agency reports it) the state where the funded work actually happens are sourced from USASpending.gov, the official record of federal spending. Place-of-performance data powers the state-by-state map.</p>
    {usaspendingRun ? (
      <ul class="stat-list">
        <li><span>Last successful sync</span><span class="mono">{formatDateTime(usaspendingRun.started_at)}</span></li>
        <li><span>Records processed that run</span><span class="mono">{usaspendingRun.records_processed}</span></li>
        <li><span>Awards with state data</span><span class="mono">{stateDataCount !== null ? stateDataCount.toLocaleString() : '—'}</span></li>
      </ul>
    ) : (
      <p class="empty">This sync hasn't completed successfully yet — award, recipient, and funding data isn't shown on the site until it does. No estimated or placeholder figures are shown in the meantime.</p>
    )}
  </div>

  <h2 class="section-title">How opportunities and awards are matched</h2>
  <p class="note">
    Where possible, a specific award is linked back to the Grants.gov opportunity that produced it (shown as
    "Where it went last cycle" on opportunity pages). Since USASpending and Grants.gov don't share a common ID,
    matching happens in two tiers, and each match is honestly labeled with which one found it:
  </p>
  <ul class="plain-list">
    <li><strong>Exact match</strong> — the award directly reports the Grants.gov funding opportunity number it came from. The strongest possible match, but only some agencies report this field.</li>
    <li><strong>CFDA-inferred match</strong> — the award and opportunity share the same CFDA (assistance listing) number and awarding agency. A reasonable inference, not a guaranteed exact link, and labeled as such wherever it's shown.</li>
  </ul>
  {matchCounts.length > 0 ? (
    <ul class="stat-list">
      <li><span>Exact matches</span><span class="mono">{exactMatchCount.toLocaleString()}</span></li>
      <li><span>CFDA-inferred matches</span><span class="mono">{cfdaMatchCount.toLocaleString()}</span></li>
    </ul>
  ) : (
    <p class="empty">No matches recorded yet.</p>
  )}

  <h2 class="section-title">What isn't tracked yet</h2>
  <ul class="plain-list">
    <li>Per-capita funding breakdowns by state (the raw state totals are tracked and shown on the map; per-capita adjustment isn't built yet)</li>
    <li>Exact matches are still filling in — funding opportunity numbers are fetched a small batch at a time in the background, so the exact-match count above will keep growing rather than reflecting every award all at once</li>
    <li>Accounts, saved searches, or email alerts — none of this site requires or stores a login</li>
  </ul>

  <h2 class="section-title">A note on accuracy</h2>
  <p class="note">
    This site does not use estimated, sample, or placeholder figures anywhere. Where a data source
    hasn't successfully synced, the relevant section says so plainly rather than showing invented numbers.
  </p>
</div>

</Base>

<style>
  .wrap{ max-width:760px; margin:0 auto; padding:34px 28px 60px; }
  .breadcrumb{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--ink-muted); margin:0 0 20px; }
  .breadcrumb a{ text-decoration:none; color:var(--ink-muted); }
  .breadcrumb a:hover{ color:var(--verdigris-deep); }

  .title{ font-family:'Fraunces', serif; font-size:32px; font-weight:600; margin:0 0 16px; }
  .intro{ font-size:15px; line-height:1.65; color:var(--ink-text); margin-bottom:32px; }

  .source-card{
    background:var(--paper-soft); border:1px solid var(--paper-line); border-radius:2px;
    padding:24px; margin-bottom:20px;
  }
  .source-card h2{ font-family:'Fraunces', serif; font-size:18px; font-weight:600; margin:0 0 10px; }
  .source-desc{ font-size:13.5px; color:var(--ink-muted); line-height:1.6; margin-bottom:16px; }

  .stat-list{ list-style:none; padding:0; margin:0; font-size:13.5px; }
  .stat-list li{ padding:8px 0; border-top:1px solid var(--paper-line); display:flex; justify-content:space-between; gap:10px; }
  .stat-list li:first-child{ border-top:none; }

  .empty{ font-size:13.5px; color:var(--ink-muted); font-style:italic; margin:0; }

  .section-title{ font-family:'Fraunces', serif; font-size:20px; font-weight:600; margin:36px 0 14px; }
  .plain-list{ font-size:14px; color:var(--ink-text); line-height:1.7; padding-left:20px; margin:0 0 24px; }
  .note{ font-size:14px; color:var(--ink-muted); line-height:1.65; }
</style>
