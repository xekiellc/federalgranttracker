---
import Base from '../../layouts/Base.astro';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;

let opportunity: {
  title: string;
  opportunity_number: string;
  status: string;
  posted_date: string | null;
  close_date: string | null;
  cfda_number: string | null;
  funding_mechanism: string | null;
  description: string | null;
  eligible_applicants: string | null;
  agency_name: string | null;
  agency_slug: string | null;
} | null = null;

try {
  const db = (env as any)?.DB;
  if (db && slug) {
    opportunity = await db
      .prepare(`
        SELECT o.title, o.opportunity_number, o.status, o.posted_date, o.close_date,
               o.cfda_number, o.funding_mechanism, o.description, o.eligible_applicants,
               a.name as agency_name, a.slug as agency_slug
        FROM opportunities o
        LEFT JOIN agencies a ON o.agency_id = a.id
        WHERE o.slug = ?
      `)
      .bind(slug)
      .first();
  }
} catch (err) {
  console.error('Opportunity page D1 query failed:', err);
}

const lifecycleStage = opportunity?.status === 'posted' ? 'open' : opportunity?.status;

function formatDate(iso: string | null): string {
  if (!iso) return '—';
  const d = new Date(iso + 'T00:00:00Z');
  if (isNaN(d.getTime())) return '—';
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}

const pageTitle = opportunity
  ? `${opportunity.title} — Federal Grant Tracker`
  : 'Opportunity not found — Federal Grant Tracker';
---
<Base title={pageTitle}>

<div class="wrap">
  {opportunity ? (
    <>
      <p class="breadcrumb"><a href="/">Home</a> / Opportunity</p>

      <div class="record">
        <span class="stamp">{lifecycleStage === 'open' ? 'Open' : lifecycleStage === 'forecasted' ? 'Forecasted' : lifecycleStage === 'closed' ? 'Closed' : 'Archived'}</span>
        <div class="record__main">
          <p class="record__agency">
            {opportunity.agency_slug
              ? <a href={`/agency/${opportunity.agency_slug}`}>{opportunity.agency_name ?? 'Agency unknown'}</a>
              : (opportunity.agency_name ?? 'Agency unknown')}
          </p>
          <h1 class="record__title">{opportunity.title}</h1>
          <p class="record__meta">
            Posted {formatDate(opportunity.posted_date)}
            {opportunity.close_date ? ` · Closes ${formatDate(opportunity.close_date)}` : ' · No close date set yet'}
          </p>

          <div class="record__lifecycle">
            <span class={`stage ${lifecycleStage === 'forecasted' ? 'current' : ''}`}>Forecasted</span><span class="arrow">→</span>
            <span class={`stage ${lifecycleStage === 'open' ? 'current' : ''}`}>Open</span><span class="arrow">→</span>
            <span class={`stage ${lifecycleStage === 'closed' ? 'current' : ''}`}>Closed</span><span class="arrow">→</span>
            <span class={`stage ${lifecycleStage === 'archived' ? 'current' : ''}`}>Archived</span>
          </div>

          {opportunity.description ? (
            <p class="description">{opportunity.description}</p>
          ) : (
            <p class="description empty">No description synced from Grants.gov for this opportunity yet.</p>
          )}

          <ul class="record__list">
            <li><span>Opportunity number</span><span class="mono">{opportunity.opportunity_number}</span></li>
            <li><span>CFDA number</span><span class="mono">{opportunity.cfda_number ?? '—'}</span></li>
            <li><span>Funding mechanism</span><span>{opportunity.funding_mechanism ?? '—'}</span></li>
            <li><span>Eligible applicants</span><span>{opportunity.eligible_applicants ?? '—'}</span></li>
          </ul>
        </div>

        <div class="record__side">
          <h4>Where it went last cycle</h4>
          <p class="empty-note">Award history isn't tracked yet — this section goes live once the USASpending sync is built.</p>
        </div>
      </div>
    </>
  ) : (
    <div class="not-found">
      <p class="breadcrumb"><a href="/">Home</a></p>
      <h1>Opportunity not found</h1>
      <p>We don't have a tracked opportunity at this address. It may have been removed, or the link may be incorrect.</p>
      <a href="/" class="back-link">← Back to homepage</a>
    </div>
  )}
</div>

</Base>

<style>
  .wrap{ max-width:900px; margin:0 auto; padding:34px 28px 60px; }
  .breadcrumb{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--ink-muted); margin:0 0 20px; }
  .breadcrumb a{ text-decoration:none; color:var(--ink-muted); }
  .breadcrumb a:hover{ color:var(--verdigris-deep); }

  .record{
    background:var(--paper-soft); border:1px solid var(--ink); padding:30px; position:relative;
    display:grid; grid-template-columns:1.3fr 1fr; gap:28px;
  }
  .record__agency{
    font-family:'IBM Plex Mono', monospace; font-size:11.5px; letter-spacing:0.1em;
    color:var(--ink-muted); text-transform:uppercase; margin:0 0 8px;
  }
  .record__agency a{ text-decoration:none; color:inherit; }
  .record__agency a:hover{ color:var(--verdigris-deep); }
  .record__title{ font-family:'Fraunces', serif; font-size:28px; font-weight:600; margin:0 0 12px; line-height:1.15; }
  .record__meta{ font-size:13.5px; color:var(--ink-muted); margin-bottom:16px; }
  .record__lifecycle{
    display:flex; align-items:center; gap:6px; margin-bottom:20px; font-family:'IBM Plex Mono', monospace;
    font-size:10px; letter-spacing:0.04em; text-transform:uppercase; color:var(--ink-muted); flex-wrap:wrap;
  }
  .record__lifecycle .stage{ padding:2px 0; }
  .record__lifecycle .stage.current{ color:var(--verdigris-deep); font-weight:600; }
  .record__lifecycle .arrow{ opacity:0.4; }
  .description{ font-size:14.5px; line-height:1.6; color:var(--ink-text); margin-bottom:20px; }
  .description.empty{ color:var(--ink-muted); font-style:italic; }
  .record__list{ list-style:none; padding:0; margin:0; font-size:13.5px; }
  .record__list li{ padding:9px 0; border-top:1px solid var(--paper-line); display:flex; justify-content:space-between; gap:10px; }
  .record__list li:first-child{ border-top:none; }

  .stamp{
    position:absolute; top:26px; right:30px; border:2px solid var(--verdigris-deep); color:var(--verdigris-deep);
    font-family:'IBM Plex Mono', monospace; font-weight:600; font-size:12px; letter-spacing:0.14em;
    padding:6px 14px; border-radius:3px; transform:rotate(-7deg); opacity:0.9;
  }

  .record__side{ border-left:1px solid var(--paper-line); padding-left:26px; }
  .record__side h4{ font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-muted); margin:0 0 10px; font-weight:600; }
  .empty-note{ font-size:13.5px; color:var(--ink-muted); line-height:1.6; }

  .not-found{ padding:40px 0; }
  .not-found h1{ font-family:'Fraunces', serif; font-size:28px; margin:0 0 12px; }
  .not-found p{ color:var(--ink-muted); font-size:14.5px; margin-bottom:20px; }
  .back-link{ color:var(--verdigris-deep); font-weight:600; text-decoration:none; font-size:14px; }
  .back-link:hover{ text-decoration:underline; }

  @media (max-width: 700px){
    .record{ grid-template-columns:1fr; }
    .record__side{ border-left:none; border-top:1px solid var(--paper-line); padding-left:0; padding-top:18px; margin-top:18px; }
    .stamp{ position:static; display:inline-block; margin-bottom:14px; transform:rotate(-4deg); }
  }
</style>
