---
import Base from '../layouts/Base.astro';
import { env } from 'cloudflare:workers';

let agencies: {
  slug: string;
  code: string;
  name: string;
  opportunity_count: number;
}[] = [];

try {
  const db = (env as any)?.DB;
  if (db) {
    const result = await db
      .prepare(`
        SELECT a.slug, a.code, a.name,
               COUNT(o.id) as opportunity_count
        FROM agencies a
        LEFT JOIN opportunities o ON o.agency_id = a.id
        GROUP BY a.id
        ORDER BY opportunity_count DESC, a.name ASC
      `)
      .all();
    agencies = (result?.results as any[]) ?? [];
  }
} catch (err) {
  console.error('Agencies index D1 query failed:', err);
}
---
<Base title="Agencies — Federal Grant Tracker">

<div class="wrap">
  <p class="breadcrumb"><a href="/">Home</a> / Agencies</p>
  <h1 class="title">Agencies</h1>
  <p class="sub">{agencies.length} federal {agencies.length === 1 ? 'agency' : 'agencies'} tracked</p>

  {agencies.length > 0 ? (
    <div class="grid">
      {agencies.map((a) => (
        <a class="card" href={`/agency/${a.slug}`}>
          <span class="card__code">{a.code}</span>
          <span class="card__name">{a.name}</span>
          <span class="card__count">{a.opportunity_count} {a.opportunity_count === 1 ? 'opportunity' : 'opportunities'}</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="empty">No agencies tracked yet.</p>
  )}
</div>

</Base>

<style>
  .wrap{ max-width:1180px; margin:0 auto; padding:34px 28px 60px; }
  .breadcrumb{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--ink-muted); margin:0 0 20px; }
  .breadcrumb a{ text-decoration:none; color:var(--ink-muted); }
  .breadcrumb a:hover{ color:var(--verdigris-deep); }

  .title{ font-family:'Fraunces', serif; font-size:32px; font-weight:600; margin:0 0 8px; }
  .sub{ font-size:14px; color:var(--ink-muted); margin-bottom:28px; }

  .grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:14px; }
  .card{
    display:flex; flex-direction:column; gap:6px; padding:20px; background:var(--paper-soft);
    border:1px solid var(--paper-line); text-decoration:none; color:inherit; border-radius:2px;
  }
  .card:hover{ border-color:var(--verdigris-deep); }
  .card__code{ font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.08em; color:var(--verdigris-deep); font-weight:600; }
  .card__name{ font-size:15px; font-weight:500; color:var(--ink-text); line-height:1.3; }
  .card__count{ font-size:12.5px; color:var(--ink-muted); margin-top:4px; }

  .empty{ font-size:14px; color:var(--ink-muted); border:1px dashed var(--paper-line); padding:24px; border-radius:2px; }
</style>
