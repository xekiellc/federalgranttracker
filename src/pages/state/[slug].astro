---
import Base from '../../layouts/Base.astro';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;

let state: { name: string; code: string } | null = null;
let awards: {
  amount: number;
  award_date: string;
  recipient_name: string;
  agency_name: string | null;
}[] = [];
let totalAmount: number | null = null;
let recipientCount = 0;

function formatCompactUsd(amount: number | null): string {
  if (amount === null || !Number.isFinite(amount)) return '—';
  const abs = Math.abs(amount);
  if (abs >= 1_000_000_000) return `$${(amount / 1_000_000_000).toFixed(1)}B`;
  if (abs >= 1_000_000) return `$${(amount / 1_000_000).toFixed(1)}M`;
  if (abs >= 1_000) return `$${(amount / 1_000).toFixed(1)}K`;
  return `$${amount.toLocaleString()}`;
}

function formatFullUsd(amount: number | null): string {
  if (amount === null || !Number.isFinite(amount)) return '—';
  return `$${amount.toLocaleString()}`;
}

function formatDate(iso: string | null): string {
  if (!iso) return '—';
  const d = new Date(iso + 'T00:00:00Z');
  if (isNaN(d.getTime())) return '—';
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}

try {
  const db = (env as any)?.DB;
  if (db && slug) {
    state = await db
      .prepare(`SELECT name, code FROM states WHERE slug = ?`)
      .bind(slug)
      .first();

    if (state) {
      const result = await db
        .prepare(`
          SELECT a.amount, a.award_date, r.name as recipient_name, ag.name as agency_name
          FROM awards a
          JOIN recipients r ON a.recipient_id = r.id
          LEFT JOIN agencies ag ON a.agency_id = ag.id
          WHERE a.place_of_performance_state_id = (SELECT id FROM states WHERE slug = ?)
          ORDER BY a.award_date DESC
        `)
        .bind(slug)
        .all();
      awards = (result?.results as any[]) ?? [];
      totalAmount = awards.reduce((sum, a) => sum + (a.amount ?? 0), 0);
      recipientCount = new Set(awards.map((a) => a.recipient_name)).size;
    }
  }
} catch (err) {
  console.error('State page D1 query failed:', err);
}

const pageTitle = state
  ? `${state.name} — Federal Grant Tracker`
  : 'State not found — Federal Grant Tracker';
---
<Base title={pageTitle}>

<div class="wrap">
  {state ? (
    <>
      <p class="breadcrumb"><a href="/">Home</a> / <a href="/#map">Map</a> / {state.name}</p>
      <h1 class="title">{state.name}</h1>
      <p class="type">Funding shown reflects place of performance — where the funded work happens, not necessarily where the recipient is headquartered.</p>

      <div class="summary">
        <div class="summary__cell">
          <span class="summary__num">{formatCompactUsd(totalAmount)}</span>
          <span class="summary__label">Total funding</span>
        </div>
        <div class="summary__cell">
          <span class="summary__num">{awards.length}</span>
          <span class="summary__label">{awards.length === 1 ? 'Award' : 'Awards'} tracked</span>
        </div>
        <div class="summary__cell">
          <span class="summary__num">{recipientCount}</span>
          <span class="summary__label">{recipientCount === 1 ? 'Recipient' : 'Recipients'}</span>
        </div>
      </div>

      <h2 class="section-title">Award history</h2>
      {awards.length > 0 ? (
        <div class="list">
          {awards.map((a) => (
            <div class="row">
              <span class="row__recipient">{a.recipient_name}</span>
              <span class="row__agency">{a.agency_name ?? 'Agency unknown'}</span>
              <span class="row__amt">{formatFullUsd(a.amount)}</span>
              <span class="row__date">{formatDate(a.award_date)}</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="empty">No awards tracked for this state yet.</p>
      )}
    </>
  ) : (
    <div class="not-found">
      <p class="breadcrumb"><a href="/">Home</a></p>
      <h1>State not found</h1>
      <p>We don't track a state at this address.</p>
      <a href="/#map" class="back-link">← Back to the map</a>
    </div>
  )}
</div>

</Base>

<style>
  .wrap{ max-width:900px; margin:0 auto; padding:34px 28px 60px; }
  .breadcrumb{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--ink-muted); margin:0 0 20px; }
  .breadcrumb a{ text-decoration:none; color:var(--ink-muted); }
  .breadcrumb a:hover{ color:var(--verdigris-deep); }

  .title{ font-family:'Fraunces', serif; font-size:30px; font-weight:600; margin:0 0 6px; line-height:1.15; }
  .type{ font-size:13px; color:var(--ink-muted); line-height:1.6; margin:0 0 24px; max-width:56ch; }

  .summary{
    display:grid; grid-template-columns:repeat(3, 1fr); border:1px solid var(--ink);
    margin:20px 0 32px;
  }
  .summary__cell{ padding:20px 24px; border-left:1px solid var(--paper-line); }
  .summary__cell:first-child{ border-left:none; }
  .summary__num{ font-family:'IBM Plex Mono', monospace; font-size:28px; font-weight:600; display:block; }
  .summary__label{ font-size:11.5px; letter-spacing:0.08em; text-transform:uppercase; color:var(--ink-muted); margin-top:6px; display:block; }

  .section-title{ font-family:'Fraunces', serif; font-size:20px; font-weight:600; margin:0 0 14px; }

  .list{ border:1px solid var(--paper-line); background:var(--paper-soft); }
  .row{
    display:grid; grid-template-columns:1.6fr 1fr 120px 120px; gap:16px; align-items:center;
    padding:14px 20px; border-top:1px solid var(--paper-line); font-size:13.5px;
  }
  .row:first-child{ border-top:none; }
  .row__recipient{ color:var(--ink-text); }
  .row__agency{ font-family:'IBM Plex Mono', monospace; font-size:11px; font-weight:600; color:var(--verdigris-deep); letter-spacing:0.04em; }
  .row__amt{ font-family:'IBM Plex Mono', monospace; font-weight:600; }
  .row__date{ font-family:'IBM Plex Mono', monospace; color:var(--ink-muted); font-size:12px; text-align:right; }

  .empty{ font-size:14px; color:var(--ink-muted); border:1px dashed var(--paper-line); padding:24px; border-radius:2px; }

  .not-found{ padding:40px 0; }
  .not-found h1{ font-family:'Fraunces', serif; font-size:28px; margin:0 0 12px; }
  .not-found p{ color:var(--ink-muted); font-size:14.5px; margin-bottom:20px; }
  .back-link{ color:var(--verdigris-deep); font-weight:600; text-decoration:none; font-size:14px; }
  .back-link:hover{ text-decoration:underline; }

  @media (max-width: 700px){
    .summary{ grid-template-columns:1fr; }
    .summary__cell{ border-left:none; border-top:1px solid var(--paper-line); }
    .summary__cell:first-child{ border-top:none; }
    .row{ grid-template-columns:1fr; gap:4px; }
    .row__amt, .row__date{ text-align:left; }
  }
</style>
