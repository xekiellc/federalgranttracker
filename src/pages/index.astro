  let currentMetric = 'total';

  function colorFor(v: number){
    const alpha = 0.08 + v * 0.82;
    return `rgba(79,156,130,${alpha.toFixed(2)})`;
  }

  function renderMap(){
    const map = document.getElementById('usmap');
    if(!map) return;
    map.innerHTML = '';
    STATES.forEach((s) => {
      const el = document.createElement('div');
      el.className = 'usmap__dot';
      el.style.left = s.x + '%';
      el.style.top = s.y + '%';
      el.style.background = colorFor(currentMetric === 'total' ? s.total : s.pc);
      el.textContent = s.a;
      el.title = s.n;
      el.onclick = () => selectState(s, el);
      map.appendChild(el);
    });
    const inset = document.createElement('div');
    inset.className = 'usmap__inset';
    INSET.forEach((s) => {
      const el = document.createElement('div');
      el.className = 'usmap__dot';
      el.style.background = colorFor(currentMetric === 'total' ? s.total : s.pc);
      el.textContent = s.a;
      el.title = s.n;
      el.onclick = () => selectState(s, el);
      inset.appendChild(el);
    });
    map.appendChild(inset);
  }

  function selectState(s: any, el: HTMLElement){
    document.querySelectorAll('.usmap__dot').forEach((d) => d.classList.remove('selected'));
    el.classList.add('selected');
    const amt = currentMetric === 'total' ? s.amtT : s.amtP;
    const callout = document.getElementById('mapCallout');
    if(!callout) return;
    callout.innerHTML =
      '<h4>Selected state</h4>' +
