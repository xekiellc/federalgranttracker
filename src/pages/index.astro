---
import Base from '../layouts/Base.astro';
import { env } from 'cloudflare:workers';

// Removed `export const prerender = true` — this page now renders per-request
// so it can query the live D1 database via Cloudflare's runtime env,
// instead of being frozen at build time with hardcoded numbers.
//
// Astro v6 removed `Astro.locals.runtime.env` — bindings are now accessed
// via `import { env } from 'cloudflare:workers'` instead.

let openOpportunitiesCount: number | null = null;
let agenciesTrackedCount: number | null = null;
let newestOpportunity: {
  title: string;
  status: string;
  posted_date: string | null;
  close_date: string | null;
  cfda_number: string | null;
  slug: string;
  agency_name: string | null;
} | null = null;
try {
  const db = (env as any)?.DB;
  if (!db) {
    throw new Error('D1 binding (env.DB) not found via cloudflare:workers env');
  }

  const openCountResult = await db
    .prepare(`SELECT COUNT(*) as count FROM opportunities WHERE status IN ('forecasted', 'posted')`)
    .first();
  openOpportunitiesCount = (openCountResult?.count as number) ?? 0;

  const agenciesCountResult = await db
    .prepare(`SELECT COUNT(*) as count FROM agencies`)
    .first();
  agenciesTrackedCount = (agenciesCountResult?.count as number) ?? 0;

  newestOpportunity = await db
    .prepare(`
      SELECT o.title, o.status, o.posted_date, o.close_date, o.cfda_number, o.slug,
             a.name as agency_name
      FROM opportunities o
      LEFT JOIN agencies a ON o.agency_id = a.id
      WHERE o.status IN ('forecasted', 'posted')
      ORDER BY o.posted_date DESC
      LIMIT 1
    `)
    .first();
} catch (err) {
  // If D1 is unreachable, or the runtime binding isn't where we expect it,
  // fall back to nulls rather than crashing the homepage with a 500 — the
  // template below handles null gracefully everywhere.
  console.error('Homepage D1 query failed:', err);
}

// opportunities.status uses forecasted/posted/closed/archived (see schema.sql);
// the lifecycle UI below displays "posted" as "Open" to match Grants.gov's
// own public-facing language.
const lifecycleStage = newestOpportunity?.status === 'posted' ? 'open' : newestOpportunity?.status;

function formatDate(iso: string | null): string {
  if (!iso) return '—';
  const d = new Date(iso + 'T00:00:00Z');
  if (isNaN(d.getTime())) return '—';
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---
<Base>

<section class="hero">
  <p class="hero__eyebrow">Not affiliated with any federal agency</p>
  <h1 class="hero__headline">Follow the <em>federal money.</em></h1>
  <p class="hero__sub">Every open opportunity, every award, every recipient — pulled straight from Grants.gov and USASpending.gov and laid out so you can actually use it.</p>

  <form class="search-line" role="search" method="get" action="/opportunities">
    <input type="text" name="q" placeholder="Search a grant, recipient, agency, program, or place…" aria-label="Search a grant, recipient, agency, program, or place">
    <button type="submit">Search</button>
  </form>

  <div class="ledger">
    <div class="ledger__row">
      <div class="ledger__cell">
        <!-- PLACEHOLDER: awards table doesn't exist yet (USASpending sync not
             built) — showing an honest em-dash instead of a fabricated dollar
             figure, rather than let a fake number sit next to real data. -->
        <span class="ledger__num">—</span>
        <span class="ledger__label">Awarded, FY2026</span>
      </div>
      <div class="ledger__cell">
        <span class="ledger__num">{openOpportunitiesCount !== null ? openOpportunitiesCount.toLocaleString() : '—'}</span>
        <span class="ledger__label">Open opportunities</span>
      </div>
      <div class="ledger__cell">
        <span class="ledger__num">{agenciesTrackedCount !== null ? agenciesTrackedCount : '—'}</span>
        <span class="ledger__label">Agencies tracked</span>
      </div>
      <div class="ledger__asof mono">Data as of <span id="asofDate"></span> · <a href="/about-data" class="ledger__asof-link">about this data →</a></div>
    </div>
  </div>
</section>

<div class="explore" id="explore">
  <p class="explore__label">Explore by</p>
  <div class="chip-row">
    <a class="chip" href="/agencies">Agencies</a>
    <a class="chip" href="/opportunities">All opportunities</a>
  </div>
</div>

<section class="section" id="record">
  <p class="section__eyebrow">Newest opportunity</p>

  {newestOpportunity ? (
    <div class="record">
      <span class="stamp">{lifecycleStage === 'open' ? 'Open' : 'Forecasted'}</span>
      <div class="record__main">
        <p class="record__agency">{newestOpportunity.agency_name ?? 'Agency unknown'}</p>
        <h3 class="record__title">{newestOpportunity.title}</h3>
        <p class="record__meta">
          Posted {formatDate(newestOpportunity.posted_date)}
          {newestOpportunity.close_date ? ` · Closes ${formatDate(newestOpportunity.close_date)}` : ' · No close date set yet'}
        </p>
        <div class="record__lifecycle">
          <span class={`stage ${lifecycleStage === 'forecasted' ? 'current' : ''}`}>Forecasted</span><span class="arrow">→</span>
          <span class={`stage ${lifecycleStage === 'open' ? 'current' : ''}`}>Open</span><span class="arrow">→</span>
          <span class="stage">Closed</span><span class="arrow">→</span>
          <span class="stage">Archived</span>
        </div>
        <div class="record__tabs">
          <span>Overview</span><span>Eligibility</span><span>Awards</span><span>History</span><span>Documents</span>
        </div>
        <ul class="record__list">
          <li><span>CFDA number</span><span class="mono">{newestOpportunity.cfda_number ?? '—'}</span></li>
          <li><span>Opportunity page</span><span class="mono">/opportunity/{newestOpportunity.slug}</span></li>
        </ul>
      </div>
      <div class="record__side">
        <h4>Where it went last cycle</h4>
        <!-- PLACEHOLDER: award history requires the USASpending sync, not built yet -->
        <p class="empty" style="font-size:13.5px; color:var(--ink-muted); line-height:1.6;">Award history isn't tracked yet — this section goes live once the USASpending sync is built.</p>
      </div>
    </div>
  ) : (
    <div class="record">
      <p style="padding:20px 0; color:var(--ink-muted);">No opportunities in the database yet — run the sync worker to populate this.</p>
    </div>
  )}
</section>

<section class="section" id="lookup">
  <!-- Recipient lookup requires the `recipients` and `awards` tables,
       sourced from USASpending.gov — not built yet. Showing an honest
       not-available state rather than any sample/mock numbers. -->
  <div class="section__head">
    <h2 class="section__title">Recipient lookup</h2>
    <p class="section__note">Search any university, hospital, nonprofit, city, or company that receives federal funding.</p>
  </div>

  <div class="lookup">
    <form class="lookup__search" role="search" onsubmit="return false;">
      <input type="text" placeholder="Search a recipient — university, nonprofit, company, city…" aria-label="Search a recipient" disabled>
      <button type="submit" disabled>Search</button>
    </form>
    <p class="empty" style="font-size:13.5px; color:var(--ink-muted); line-height:1.6; border:1px dashed var(--paper-line); padding:20px; border-radius:2px; margin:0;">
      Recipient and award data isn't tracked yet — this section goes live once the USASpending.gov sync is built.
    </p>
  </div>
</section>

<section class="section section--map" id="map">
  <!-- State-level funding requires the `awards` table joined to `states` —
       not built yet. Showing an honest not-available state rather than a
       map filled with invented per-state dollar figures. -->
  <div class="section__head">
    <h2 class="section__title">Where the money goes</h2>
    <p class="section__note">Funding by state will appear here once award data is available.</p>
  </div>
  <div class="map-panel" style="grid-template-columns:1fr;">
    <p class="empty" style="font-size:13.5px; color:var(--ink-muted); line-height:1.6; border:1px dashed var(--paper-line); padding:32px; border-radius:2px; margin:0; text-align:center;">
      State-by-state funding data isn't tracked yet — this map goes live once the USASpending.gov sync is built.
    </p>
  </div>
</section>

<section class="section">
  <!-- Requires the `awards` table — not built yet. Showing an honest empty
       state rather than fabricated award rows. -->
  <div class="section__head">
    <h2 class="section__title">Recently awarded</h2>
    <p class="section__note">A live stream of new awards as agencies report them.</p>
  </div>
  <div class="stream">
    <p class="empty" style="font-size:13.5px; color:var(--ink-muted); line-height:1.6; padding:24px 20px; margin:0;">
      Award data isn't tracked yet — this stream goes live once the USASpending.gov sync is built.
    </p>
  </div>
</section>

</Base>

<style>
  .hero{ max-width:1180px; margin:0 auto; padding:60px 28px 32px; }
  .hero__eyebrow{
    font-family:'IBM Plex Mono', monospace; font-size:11.5px; letter-spacing:0.18em;
    color:var(--wax); text-transform:uppercase; margin:0 0 18px;
  }
  h1.hero__headline{
    font-family:'Fraunces', serif; font-weight:600; font-size:clamp(40px, 6vw, 74px);
    line-height:0.98; letter-spacing:-0.01em; margin:0 0 22px; max-width:14ch;
  }
  .hero__headline em{ font-style:italic; color:var(--verdigris-deep); }
  .hero__sub{ font-size:17px; line-height:1.6; color:var(--ink-muted); max-width:52ch; margin:0 0 30px; }

  .search-line{
    display:flex; align-items:center; gap:12px; background:var(--paper-soft);
    border:1px solid var(--ink); padding:6px 6px 6px 20px; max-width:620px; border-radius:2px;
  }
  .search-line input{
    border:none; background:transparent; flex:1; font-family:'IBM Plex Mono', monospace;
    font-size:14px; padding:12px 0; color:var(--ink-text);
  }
  .search-line input::placeholder{ color:var(--ink-muted); }
  .search-line input:focus{ outline:none; }
  .search-line button{
    background:var(--verdigris-deep); color:var(--paper); border:none; padding:11px 20px;
    border-radius:1px; font-weight:600; font-size:13px; cursor:pointer; font-family:inherit; white-space:nowrap;
  }
  .search-line button:hover{ background:#255241; }

  .ledger{ max-width:1180px; margin:32px auto 0; padding:0 28px; }
  .ledger__asof-link{
    background:none; border:none; padding:0; cursor:pointer; font-family:'IBM Plex Mono', monospace;
    color:var(--ink-muted); text-decoration:underline; text-decoration-style:dotted; text-underline-offset:3px;
  }
  .ledger__asof-link:hover{ color:var(--verdigris-deep); }
  .ledger__row{
    display:grid; grid-template-columns:repeat(3, 1fr) auto; border-top:1px solid var(--ink);
    border-bottom:1px solid var(--ink); align-items:center;
  }
  .ledger__cell{ padding:20px 24px; border-left:1px solid var(--paper-line); }
  .ledger__cell:first-child{ border-left:none; padding-left:0; }
  .ledger__num{
    font-family:'IBM Plex Mono', monospace; font-size:clamp(24px, 3.2vw, 36px);
    font-weight:600; color:var(--ink); display:block;
  }
  .ledger__num .accent{ color:var(--verdigris-deep); }
  .ledger__label{
    font-size:11.5px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-muted);
    margin-top:6px; display:block;
  }
  .ledger__asof{ font-family:'IBM Plex Mono', monospace; font-size:10.5px; color:var(--ink-muted); padding:0 24px; white-space:nowrap; }

  .explore{ max-width:1180px; margin:0 auto; padding:20px 28px 4px; }
  .explore__label{
    font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.16em;
    color:var(--ink-muted); text-transform:uppercase; margin:0 0 12px;
  }
  .chip-row{ display:flex; flex-wrap:wrap; gap:10px; }
  .chip{
    border:1px solid var(--paper-line); padding:8px 15px; border-radius:20px; font-size:13px;
    font-weight:500; background:var(--paper-soft); cursor:pointer; text-decoration:none; color:var(--ink-text);
  }
  .chip:hover{ border-color:var(--verdigris-deep); color:var(--verdigris-deep); }

  .section{ max-width:1180px; margin:0 auto; padding:34px 28px; }
  .section--map{ padding-top:8px; }
  .section__eyebrow{
    font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.16em;
    color:var(--ink-muted); text-transform:uppercase; margin:0 0 14px;
  }
  .section__head{ display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:18px; gap:20px; flex-wrap:wrap; }
  .section__title{ font-family:'Fraunces', serif; font-weight:600; font-size:24px; margin:0; }
  .section__note{ font-size:13.5px; color:var(--ink-muted); max-width:36ch; }

  .record{
    background:var(--paper-soft); border:1px solid var(--ink); padding:30px; position:relative;
    display:grid; grid-template-columns:1.3fr 1fr; gap:28px;
  }
  .record__agency{
    font-family:'IBM Plex Mono', monospace; font-size:11.5px; letter-spacing:0.1em;
    color:var(--ink-muted); text-transform:uppercase; margin:0 0 8px;
  }
  .record__title{ font-family:'Fraunces', serif; font-size:25px; font-weight:600; margin:0 0 12px; max-width:20ch; }
  .record__amount{ font-family:'IBM Plex Mono', monospace; font-size:21px; font-weight:600; color:var(--verdigris-deep); margin-bottom:4px; }
  .record__meta{ font-size:13.5px; color:var(--ink-muted); margin-bottom:16px; }
  .record__tabs{ display:flex; gap:2px; margin-bottom:18px; flex-wrap:wrap; }
  .record__tabs span{
    font-family:'IBM Plex Mono', monospace; font-size:10.5px; letter-spacing:0.06em; padding:6px 10px;
    color:var(--ink-muted); border:1px solid var(--paper-line); border-radius:2px; text-transform:uppercase;
  }
  .record__tabs span:first-child{ color:var(--ink); border-color:var(--ink); font-weight:600; }
  .record__lifecycle{
    display:flex; align-items:center; gap:6px; margin-bottom:16px; font-family:'IBM Plex Mono', monospace;
    font-size:10px; letter-spacing:0.04em; text-transform:uppercase; color:var(--ink-muted); flex-wrap:wrap;
  }
  .record__lifecycle .stage{ padding:2px 0; }
  .record__lifecycle .stage.current{ color:var(--verdigris-deep); font-weight:600; }
  .record__lifecycle .arrow{ opacity:0.4; }
  .record__lifecycle .stage-sep{ opacity:0.4; margin:0 2px; }
  .record__lifecycle .stage-awards{ color:var(--ink-muted); text-transform:none; letter-spacing:0; }
  .record__list{ list-style:none; padding:0; margin:0; font-size:13.5px; }
  .record__list li{ padding:9px 0; border-top:1px solid var(--paper-line); display:flex; justify-content:space-between; gap:10px; }
  .record__list li:first-child{ border-top:none; }

  .stamp{
    position:absolute; top:26px; right:30px; border:2px solid var(--verdigris-deep); color:var(--verdigris-deep);
    font-family:'IBM Plex Mono', monospace; font-weight:600; font-size:12px; letter-spacing:0.14em;
    padding:6px 14px; border-radius:3px; transform:rotate(-7deg); opacity:0.9;
  }
  .stamp::before, .stamp::after{ content:''; position:absolute; inset:3px; border:1px solid var(--verdigris-deep); border-radius:1px; opacity:0.5; }

  .record__side{ border-left:1px solid var(--paper-line); padding-left:26px; }
  .record__side h4{ font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-muted); margin:0 0 10px; font-weight:600; }
  .past-award{ display:flex; justify-content:space-between; font-size:13.5px; padding:7px 0; border-top:1px solid var(--paper-line); }
  .past-award:first-of-type{ border-top:none; }
  .past-award span:first-child{ color:var(--ink-text); }
  .past-award span:last-child{ font-family:'IBM Plex Mono', monospace; color:var(--verdigris-deep); font-weight:600; }

  .lookup{ background:var(--paper-soft); border:1px solid var(--paper-line); padding:28px 30px; }
  .lookup__head{ display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:12px; margin-bottom:4px; }
  .lookup__name{ font-family:'Fraunces', serif; font-size:21px; font-weight:600; }
  .lookup__total{ font-family:'IBM Plex Mono', monospace; font-size:15px; }
  .lookup__delta{ color:var(--verdigris-deep); font-weight:600; }
  .lookup__sub{ font-size:13px; color:var(--ink-muted); margin-bottom:20px; }
  .lookup__search{
    display:flex; align-items:center; gap:10px; background:var(--paper); border:1px solid var(--paper-line);
    padding:4px 4px 4px 14px; margin-bottom:18px; border-radius:2px;
  }
  .lookup__search input{ border:none; background:transparent; flex:1; font-family:'IBM Plex Mono', monospace; font-size:13px; padding:9px 0; color:var(--ink-text); }
  .lookup__search input:focus{ outline:none; }
  .lookup__search button{
    background:var(--ink); color:var(--paper); border:none; padding:8px 14px; border-radius:1px;
    font-size:12px; font-weight:600; cursor:pointer; font-family:inherit; white-space:nowrap;
  }
  .lookup__try{ font-size:12px; color:var(--ink-muted); margin:-8px 0 22px; }
  .lookup__try button{
    background:none; border:none; padding:0; cursor:pointer; font-family:inherit; font-size:inherit;
    color:var(--verdigris-deep); text-decoration:underline; text-decoration-style:dotted;
  }
  .bar-row{ display:grid; grid-template-columns:70px 1fr 90px; align-items:center; gap:14px; margin-bottom:10px; }
  .bar-row__label{ font-family:'IBM Plex Mono', monospace; font-size:12.5px; color:var(--ink-muted); }
  .bar-row__track{ background:var(--paper-line-soft); height:9px; border-radius:2px; overflow:hidden; }
  .bar-row__fill{ height:100%; border-radius:2px; background:var(--verdigris); }
  .bar-row__val{ font-family:'IBM Plex Mono', monospace; font-size:12.5px; text-align:right; }

  .map-panel{
    display:grid; grid-template-columns:1.5fr 1fr; gap:28px; background:var(--paper-soft);
    border:1px solid var(--paper-line); padding:26px 28px;
  }
  .map-stage{ display:flex; flex-direction:column; gap:12px; }
  .metric-toggle{ display:inline-flex; align-self:flex-start; border:1px solid var(--ink); border-radius:2px; overflow:hidden; }
  .metric-toggle button{
    font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.05em; text-transform:uppercase;
    padding:7px 14px; border:none; background:transparent; color:var(--ink-muted); cursor:pointer; font-weight:600;
  }
  .metric-toggle button + button{ border-left:1px solid var(--ink); }
  .metric-toggle button.active{ background:var(--ink); color:var(--paper); }

  .usmap{ position:relative; width:100%; padding-bottom:56%; background:var(--paper); border:1px solid var(--paper-line); }
  .usmap__dot{
    position:absolute; width:20px; height:20px; transform:translate(-50%,-50%); border-radius:4px;
    display:flex; align-items:center; justify-content:center; font-family:'IBM Plex Mono', monospace;
    font-size:7.5px; font-weight:600; color:var(--ink); cursor:pointer; border:1px solid rgba(14,27,36,0.18);
    transition:transform 0.12s ease;
  }
  .usmap__dot:hover{ transform:translate(-50%,-50%) scale(1.35); z-index:2; border-color:var(--ink); }
  .usmap__dot.selected{ outline:2px solid var(--wax); outline-offset:1px; z-index:3; }
  .usmap__inset{ position:absolute; left:8px; bottom:8px; display:flex; gap:6px; padding:5px; border:1px dashed var(--paper-line); }
  .usmap__inset .usmap__dot{ position:static; transform:none; }
  .usmap__inset .usmap__dot:hover{ transform:scale(1.2); }

  .map-legend{ display:flex; align-items:center; gap:8px; font-family:'IBM Plex Mono', monospace; font-size:10.5px; color:var(--ink-muted); }
  .map-legend .grad{ width:120px; height:9px; border-radius:2px; background:linear-gradient(90deg, rgba(79,156,130,0.08), rgba(79,156,130,0.95)); }
  .map-note{ font-size:11.5px; color:var(--ink-muted); }

  .map-callout{ display:flex; flex-direction:column; }
  .map-callout h4{ font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-muted); margin:0 0 6px; font-weight:600; }
  .map-callout .place{ font-family:'Fraunces', serif; font-size:20px; font-weight:600; margin-bottom:10px; }
  .map-callout .empty{ font-size:13.5px; color:var(--ink-muted); line-height:1.6; border:1px dashed var(--paper-line); padding:20px; border-radius:2px; }
  .map-callout .stat-line{ display:flex; justify-content:space-between; font-size:13.5px; padding:8px 0; border-top:1px solid var(--paper-line); }
  .map-callout .stat-line:first-of-type{ border-top:none; }
  .map-callout .stat-line span:last-child{ font-family:'IBM Plex Mono', monospace; font-weight:600; }
  .map-callout .view-link{ margin-top:14px; font-size:13px; font-weight:600; color:var(--verdigris-deep); text-decoration:none; }
  .map-callout .view-link:hover{ text-decoration:underline; }

  .stream{ border:1px solid var(--paper-line); background:var(--paper-soft); }
  .stream__row{
    display:grid; grid-template-columns:80px 70px 130px 1.4fr 1fr; gap:16px; align-items:center;
    padding:13px 20px; border-top:1px solid var(--paper-line); font-size:13px;
  }
  .stream__row:first-child{ border-top:none; }
  .stream__time{ font-family:'IBM Plex Mono', monospace; color:var(--ink-muted); font-size:11.5px; }
  .stream__agency{ font-family:'IBM Plex Mono', monospace; font-size:11px; font-weight:600; color:var(--verdigris-deep); letter-spacing:0.04em; }
  .stream__amt{ font-family:'IBM Plex Mono', monospace; font-weight:600; }
  .stream__recipient{ color:var(--ink-text); }
  .stream__program{ color:var(--ink-muted); font-size:12.5px; }
  .stream__foot{ padding:14px 20px; border-top:1px solid var(--paper-line); font-size:13px; font-weight:600; color:var(--verdigris-deep); }
  .stream__foot a{ text-decoration:none; }
  .stream__foot a:hover{ text-decoration:underline; }

  @media (max-width: 860px){
    .ledger__row{ grid-template-columns:1fr; }
    .ledger__cell{ border-left:none; border-top:1px solid var(--paper-line); padding-left:0; }
    .ledger__cell:first-child{ border-top:none; }
    .ledger__asof{ padding:12px 0 0; }
    .record{ grid-template-columns:1fr; }
    .record__side{ border-left:none; border-top:1px solid var(--paper-line); padding-left:0; padding-top:18px; }
    .map-panel{ grid-template-columns:1fr; }
    .usmap{ padding-bottom:70%; }
    .stream__row{ grid-template-columns:1fr; gap:4px; }
    .stream__time{ order:-1; }
  }
</style>

<script>
  // "Data as of" date — rendered client-side to avoid caching a stale
  // build-time date on a now server-rendered page.
  const asof = document.getElementById('asofDate');
  if (asof) {
    asof.textContent = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }
</script>
