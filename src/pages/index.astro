      '<div class="stat-line"><span>Recipients</span><span>' + s.rc + '</span></div>' +
      '<a href="#" class="view-link">Explore ' + s.n + ' →</a>';
  }

  function setMetric(metric: string){
    currentMetric = metric;
    document.querySelectorAll('.metric-toggle button').forEach((b) => {
      b.classList.toggle('active', (b as HTMLElement).dataset.metric === metric);
    });
    renderMap();
  }

